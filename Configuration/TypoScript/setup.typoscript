plugin.tx_booking {
    _CSS_DEFAULT_STYLE (
        /* Booking extension default layout styles */
        .tx_booking {
          clear: both;
          display: block;
          margin-top: 1rem;
        }

        @media screen and (max-width: 500px) {
          .tx_booking {
            font-size: .85rem;
            padding: 0;
          }
        }

        .tx_booking button {
          background: none !important;
          border-width: 0;
          color: #052f96;
          margin: 0 !important;
          padding: 0 !important;
        }

        .tx_booking .fa-check,
        .tx_booking .fa-times {
          font-size: 2rem;
        }

        .tx_booking .fa-check:hover, .tx_booking .fa-check:focus,
        .tx_booking .fa-times:hover,
        .tx_booking .fa-times:focus {
          cursor: pointer;
        }

        .tx_booking .fa-check::after,
        .tx_booking .fa-times::after {
          content: attr(title);
          display: none;
          font-size: .85rem;
          padding-left: .25rem;
          position: relative;
          z-index: 100;
        }

        .tx_booking .fa-check:hover::after,
        .tx_booking .fa-times:hover::after {
          display: block;
        }

        .tx_booking .fa-check:hover, .tx_booking .fa-check:focus {
          color: #418888;
        }

        .tx_booking .fa-times:hover, .tx_booking .fa-times:focus {
          color: #fff;
        }

        .tx_booking table tr th,
        .tx_booking table tr td {
          padding: .5rem;
          vertical-align: middle;
          width: auto;
        }

        .tx_booking .calendarWeek {
          font-size: 1em;
          margin-top: 1.5rem;
        }

        .tx_booking .calendarWeek:nth-of-type(1) {
          margin-top: 0;
        }

        .tx_booking .calendarWeek.row {
          padding-left: 15px;
        }

        .tx_booking .calendarWeek .legend {
          margin-bottom: 1rem;
        }

        .tx_booking .calendarWeek .legend .offDutyHour,
        .tx_booking .calendarWeek .legend .bookedHour,
        .tx_booking .calendarWeek .legend .ownBookedHour,
        .tx_booking .calendarWeek .legend .availableHour {
          color: #fff;
          font-weight: normal;
          height: 1rem;
          padding: .25em .5em;
          width: 4rem;
        }

        .tx_booking .calendarWeek .legend .offDutyHour {
          background-color: #e0e0e0;
          color: #000;
        }

        .tx_booking .calendarWeek .legend .bookedHour {
          background-color: #d43e26;
        }

        .tx_booking .calendarWeek .legend .ownBookedHour {
          background-color: #f08a24;
        }

        .tx_booking .calendarWeek .legend .availableHour {
          background-color: #15428b;
        }

        .tx_booking .roomDescription h2 {
          margin-bottom: .5rem;
          margin-top: 0;
        }

        .tx_booking .weekView .past {
          background: #fff;
          opacity: .5;
          pointer-events: none;
        }

        .tx_booking .weekViewDay {
          border-collapse: collapse;
          float: left;
          width: 14%;
        }

        .tx_booking .weekViewDay .tableheader {
          text-align: center;
        }

        .tx_booking .weekViewDay .row {
          border-bottom: 1px solid #808080;
          border-collapse: collapse;
        }

        .tx_booking .weekViewDay .openingHours,
        .tx_booking .weekViewDay .bookedHours,
        .tx_booking .weekViewDay .ownbookedHours,
        .tx_booking .weekViewDay .offDuty,
        .tx_booking .weekViewDay .offDutyTimeHours,
        .tx_booking .weekViewDay .offDutyTime {
          border-bottom: 1px solid #808080;
          color: #fff;
          padding: .25em 0;
          text-align: center;
        }

        .tx_booking .weekViewDay .openingHours {
          background-color: #15428b;
        }

        .tx_booking .weekViewDay .bookedHours {
          background-color: #d43e26;
        }

        .tx_booking .weekViewDay .ownbookedHours {
          background-color: #f08a24;
        }

        .tx_booking .weekViewDay .offDuty {
          background-color: #e0e0e0;
          display: none;
          visibility: collapse;
        }

        .tx_booking .weekViewDay .offDutyTimeHours {
          background-color: #e0e0e0;
          color: #000;
          cursor: auto;
        }

        .tx_booking .offDutyTime {
          background-color: #d43e26;
          cursor: auto;
          font-size: .85em;
          font-weight: normal;
        }

        .tx_booking .bookingFormObjectName {
          display: block;
        }

        .tx_booking .date {
          float: left;
          font-weight: bold;
        }

        .tx_booking .week-link {
          float: right;
        }

        .tx_booking .next-day {
          display: inline;
        }

        .tx_booking .bookingForm {
          background-color: #e0e0e0;
        }

        .tx_booking .bookingForm td {
          text-align: center;
        }

        .tx_booking .bookingForm .titles td {
          font-weight: bold;
        }

        .tx_booking .bookingForm .bookedHours {
          background-color: #d43e26;
        }

        .tx_booking .bookingForm .ownbookedHours {
          background-color: #f08a24;
        }

        .tx_booking .bookingForm input {
          color: #000;
          font-weight: bold;
        }

        .tx_booking input[type='text'] {
          margin-bottom: 0;
        }

        .tx_booking .backToWeekView,
        .tx_booking .backToMonthView {
          padding: .25rem 0 .25rem 1rem;
        }
	)
}
